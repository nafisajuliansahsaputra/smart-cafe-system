# LOCAL DEVELOPMENT ONLY. Copy to .env and change the password.
POSTGRES_DB=smart_cafe
POSTGRES_USER=smart_cafe
POSTGRES_PASSWORD=replace-with-unique-local-password
# Optional: set true for local OpenAPI/Swagger docs, not for public deployments.
API_DOCS_ENABLED=true

# Optional first-time development bootstrap. Remove these after one successful run.
# NEVER enable the dev-bootstrap profile on any public server or real cafe deployment.
# SPRING_PROFILES_ACTIVE=dev-bootstrap
# SCS_BOOTSTRAP_USERNAME=localadmin
# SCS_BOOTSTRAP_PASSWORD=choose-your-own-long-random-local-secret

# Required development secret (>=32 UTF-8 bytes), change before use!
# Use a distinct strong secret per environment, and share it across API replicas.
SCS_JOIN_THROTTLE_SECRET=replace-this-local-only-guest-join-hmac-secret-unique-to-you
